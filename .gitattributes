# Normalize text files to LF in the repo; checkout renders per platform.
* text=auto eol=lf

# Keep these byte-identical across platforms.
*.png binary
*.svg binary
*.lock binary
*.json binary
*.sig binary
*.pem binary
*.der binary
*.key binary
*.p12 binary
*.pfx binary
*.crt binary
*.csr binary
*.jks binary
*.keystore binary
*.zip binary
*.tgz binary
*.tar.gz binary
*.tar.zst binary
*.wasm binary
*.avif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.pdf binary

# Project-specific generated/typo-prone files
package-lock.json binary
wrangler.jsonc text eol=lf
