# ---------------------------------------------------------------------------
# MediHelp Technologies website — Cloudflare Workers static site
#
# `worker-configuration.d.ts` is deliberately NOT ignored: it is generated by
# `npm run types:worker` but committed, so a fresh clone can run
# `npm run typecheck` and get editor support without an extra step.
# ---------------------------------------------------------------------------

# Dependencies
node_modules

# Build output — regenerate with `npm run build`
dist
dist-server
dist-worker

# Wrangler's local state (miniflare cache, dev registry)
.wrangler

# Local working files: downloaded repository data, logs, PIDs, screenshots
.audit

# Environment and secrets — never commit these
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Logs and process files
*.log
*.pid
*.tsbuildinfo

# The superseded Next.js app and its static export. Kept locally as a rollback
# artefact only; see docs/FINAL_IMPLEMENTATION_REPORT.md §2.
legacy-static-export

# Freebuff workspace metadata
.freebuff

# Editors and OS
.DS_Store
Thumbs.db
.claude
.z-ai-config
local-*

# Previously audited locally and excluded on request. Kept on disk for local
# reference only; do not publish these to GitHub.
docs/MEDIHELP_WEBSITE_AUDIT.md
docs/PORTFOLIO_PROJECT_AUDIT.md
